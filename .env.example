# Network Health Check - Environment Variables Template
# Copy this file to .env and fill in real values ONLY when connecting to Cisco DevNet Sandbox (Phase 5).
# NEVER commit .env to Git.

# Execution mode: "offline" (default simulated device) or "real" (Cisco DevNet Sandbox)
NHC_MODE=offline

# Cisco DevNet Sandbox Credentials (used in Phase 5 by testbed/devices.yaml.example)
CISCO_SANDBOX_HOST=sandbox-iosxe-latest-1.cisco.com
CISCO_SANDBOX_PORT=22
CISCO_SANDBOX_USERNAME=replace_with_sandbox_username
CISCO_SANDBOX_PASSWORD=replace_with_sandbox_password

# SQLite Database Path (used in Phase 6)
NHC_DATABASE_PATH=reports/network_health_history.db
